# Copy to application-local.properties and start with --spring.profiles.active=local
spring.datasource.url=jdbc:mysql://localhost:3306/hr_portfolio
spring.datasource.username=hr_app
spring.datasource.password=${DB_PASSWORD}
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true
# Optional Google login: set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET and activate local,oauth.
# Use an administrator-provisioned GOOGLE account. See docs/oauth-verification.md.
